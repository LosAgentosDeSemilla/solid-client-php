{
    "name": "semilla/solid-client",
    "description": "Solid client for PHP: Solid-OIDC (PKCE, DPoP), pod HTTP with ETags, WebID profiles and Type Indexes. A revived fork of dunglas/solid-client-php.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kévin Dunglas",
            "email": "kevin@dunglas.fr",
            "role": "Original author (dunglas/solid-client-php)"
        },
        {
            "name": "Los Agentos de Semilla",
            "homepage": "https://github.com/LosAgentosDeSemilla"
        }
    ],
    "require": {
        "php": ">=8.5",
        "psr/clock": "^1.0",
        "sweetrdf/easyrdf": "^1.19",
        "symfony/http-client-contracts": "^3.5",
        "web-token/jwt-library": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Semilla\\SolidClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semilla\\SolidClient\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/http-client": "^8.1"
    },
    "suggest": {
        "symfony/http-client": "The HTTP client every class here takes (contracts only are required)."
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}
